# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL=

# Random 32+ byte secret used to sign session JWTs, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Used once by `npm run create-admin` to seed the single dashboard user.
# Not read anywhere else — safe to remove after the admin account is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
